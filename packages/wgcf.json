  "description": "Cross-platform unofficial CLI for Cloudflare Warp",
  "binary": "wgcf",
  "license": "MIT",
  "homepage": "https://github.com/ViRb3/wgcf",
  "asset_pattern": {
    "linux_amd64": "wgcf_*_linux_amd64",
